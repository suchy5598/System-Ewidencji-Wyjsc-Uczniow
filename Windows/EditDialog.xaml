<Window x:Class="Projekt.Windows.EditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projekt.Windows"
        xmlns:views="clr-namespace:Projekt.Views"
        xmlns:vm="clr-namespace:Projekt.ViewModels"
        mc:Ignorable="d"
        Title="EditDialog" Height="250" Width="400"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Mapowanie ViewModeli do Widoków -->
        <DataTemplate DataType="{x:Type vm:EditClassViewModel}">
            <views:EditClassView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditStudentViewModel}">
            <views:EditStudentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditAccountViewModel}">
            <views:EditAccountView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding}" />
    </Grid>
</Window>
