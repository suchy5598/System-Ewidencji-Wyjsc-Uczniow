<UserControl x:Class="Projekt.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Projekt.Views"
             xmlns:viewmodels="clr-namespace:Projekt.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Mapowanie ViewModeli na odpowiednie Widoki XAML -->
        <DataTemplate DataType="{x:Type viewmodels:ExitsManagementViewModel}">
            <views:ExitsManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:StatisticsViewModel}">
            <views:StatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AccountsViewModel}">
            <views:AccountsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ClassesViewModel}">
            <views:ClassesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:StudentsViewModel}">
            <views:StudentsView/>
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="CornflowerBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" >
            <TextBlock Text="{Binding UserName}" FontSize="15" Margin="5"/>
            <Button Content="Wyloguj" Height="25" Margin="5"
                    Command="{Binding DataContext.ShowLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="1" Background="CornflowerBlue">
            <Button Command="{Binding ShowExitsCommand}" Margin="5,2">Wyjścia</Button>
            <Button Command="{Binding ShowStatisticsCommand}"  Visibility="{Binding IsTeacher, Converter={StaticResource BoolToVis}}" Margin="5,2">Statystyki</Button>
            <Button Command="{Binding ShowAccountsCommand}" Margin="5,2" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">Konta</Button>
            <Button Command="{Binding ShowClassesCommand}" Margin="5,2" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">Klasy</Button>
            <Button Command="{Binding ShowStudentsCommand}" Margin="5,2" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">Uczniowie</Button>
        </StackPanel>

        <ContentControl Grid.Column="1" Grid.Row="1"  Content="{Binding CurrentDashboardView}"/>

        <!--<Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding UserName}" FontSize="15" Margin="5"/>
            <Button Grid.Column="1" Content="Wyloguj" Height="25"
        Command="{Binding DataContext.ShowLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>-->
    </Grid>
</UserControl>