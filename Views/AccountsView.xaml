<UserControl x:Class="Projekt.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Projekt.Views"
             mc:Ignorable="d" 
             Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Width="300" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5">
            <TextBlock Margin="10" FontSize="20" HorizontalAlignment="Center">Konta</TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Button Margin="3" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}">Odśwież</Button>
                <Button Margin="3" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DeleteCommand}">Usuń</Button>
                <Button Margin="3" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding EditCommand}">Edytuj</Button>
            </StackPanel>
            <DataGrid MaxHeight="225" ScrollViewer.VerticalScrollBarVisibility="Visible" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="*" />
                    <DataGridTextColumn Header="Rola" Binding="{Binding UserType}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <StackPanel Grid.Column="1" Width="300" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5">
            <TextBlock Margin="10" FontSize="20" HorizontalAlignment="Center">Tworzenie konta</TextBlock>
            <Label>Podaj Login:</Label>
            <TextBox Style="{StaticResource RoundedTextBoxStyle}" x:Name="LoginBox" Margin="5" />
            <Label>Podaj Hasło:</Label>
            <TextBox Style="{StaticResource RoundedTextBoxStyle}" x:Name="PasswordBox" Margin="5"/>
            <Button  Style="{StaticResource SuccessButtonStyle}" Width="100" Margin="5" Click="Button_Click">Stwórz konto</Button>
        </StackPanel>
    </Grid>
</UserControl>
