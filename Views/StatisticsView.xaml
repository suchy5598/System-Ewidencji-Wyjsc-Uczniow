<UserControl x:Class="Projekt.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="20">
    <StackPanel Width="300" HorizontalAlignment="Left">
        <TextBlock Text="📊 Statystyki Wyjść" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <Border Background="#F4F4F4" Padding="15" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Dzisiejsze wyjścia łącznie:" Foreground="Gray"/>
                <TextBlock Text="{Binding TodayExitsCount}" FontSize="24" FontWeight="Bold" Foreground="#007ACC"/>
            </StackPanel>
        </Border>

        <Border Background="#F4F4F4" Padding="15" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Uczniowie poza klasą (teraz):" Foreground="Gray"/>
                <TextBlock Text="{Binding StudentsCurrentlyOut}" FontSize="24" FontWeight="Bold" Foreground="#D9534F"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>